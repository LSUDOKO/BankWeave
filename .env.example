# FalkorDB (graph database)
FALKORDB_HOST=localhost
FALKORDB_PORT=6390
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Redis for pub/sub events (separate from FalkorDB so it works with FalkorDB Cloud)
REDIS_URL=redis://localhost:6391/0

# Postgres KYC table
POSTGRES_URL=postgresql://postgres:bankweave@localhost:5440/kyc

# LLMs via OpenRouter (LiteLLM model strings)
OPENROUTER_API_KEY=
LLM_WRITER_MODEL=openrouter/google/gemini-3.8-flash
LLM_AUDITOR_MODEL=openrouter/anthropic/claude-sonnet-5.5

# Data
DATASET=HI-Small
DATA_DIR=data/raw
TOP_N_BANKS=4
HASH_SALT=bankweave-demo-salt
SYNTH_SEED=42

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
